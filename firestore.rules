rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if isMember(groupId);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{memberId} {
        allow read: if isMember(groupId) || (signedIn() && memberId == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.uid == memberId
          && request.resource.data.name is string
          && exists(/databases/$(database)/documents/groups/$(groupId))
          && (memberId == request.auth.uid ||
              get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid);
        allow update: if isMember(groupId) && (
          memberId == request.auth.uid ||
          get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
        );
        allow delete: if isMember(groupId) && (
          memberId == request.auth.uid ||
          get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
        );
      }
      match /tasks/{taskId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0;
        allow update, delete: if isMember(groupId);
      }
      match /penalties/{penaltyId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.targetUid is string
          && request.resource.data.type in ['money', 'challenge']
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isMember(groupId)
          && resource.data.createdBy == request.auth.uid;
      }
      match /draws/{drawId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.winnerUid is string
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}